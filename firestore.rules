rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateString(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.biometricLockEnabled is bool &&
             data.themeMode in ['gentle_sage', 'lavender_dusk', 'rose_dawn'];
    }

    function isValidCheckIn(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             isValidDateString(data.date) &&
             data.moodScore is int && data.moodScore >= 1 && data.moodScore <= 5 &&
             data.moodLabel is string && data.moodLabel.size() <= 50 &&
             data.emotionTags is list && data.emotionTags.size() <= 15 &&
             (data.emotionTags.size() == 0 || data.emotionTags[0] is string) &&
             data.energyLevel is int && data.energyLevel >= 1 && data.energyLevel <= 5 &&
             data.sleepQuality is int && data.sleepQuality >= 1 && data.sleepQuality <= 5 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    function isValidJournalEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             isValidDateString(data.date) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.gratitudeAnswers is list && data.gratitudeAnswers.size() <= 5 &&
             (data.gratitudeAnswers.size() == 0 || data.gratitudeAnswers[0] is string) &&
             data.reflection is string && data.reflection.size() <= 10000 &&
             (!('promptQuestion' in data) || (data.promptQuestion is string && data.promptQuestion.size() <= 300)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)));
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'biometricLockEnabled', 'themeMode', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'biometricLockEnabled', 'themeMode', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'biometricLockEnabled', 'themeMode', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Check-ins subcollection
      match /checkIns/{checkInId} {
        allow get: if isOwner(userId) && isValidId(checkInId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(checkInId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'date', 'moodScore', 'moodLabel', 'emotionTags', 'energyLevel', 'sleepQuality', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'date', 'moodScore', 'moodLabel', 'emotionTags', 'energyLevel', 'sleepQuality', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidCheckIn(incoming());

        allow update: if isOwner(userId) && isValidId(checkInId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCheckIn(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'moodScore', 'moodLabel', 'emotionTags', 'energyLevel', 'sleepQuality', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(checkInId);
      }

      // Journal Entries subcollection
      match /journalEntries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(entryId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'date', 'title', 'gratitudeAnswers', 'reflection', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'date', 'title', 'gratitudeAnswers', 'reflection', 'promptQuestion', 'tags', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) && isValidId(entryId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidJournalEntry(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'title', 'gratitudeAnswers', 'reflection', 'promptQuestion', 'tags', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }
    }
  }
}
